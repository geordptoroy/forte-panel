# Ambiente local do Forte Panel via docker-compose.local.yml
NODE_ENV=production
PORT=3000
PANEL_PORT=3002
DEMO_MODE=false
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_EMAIL=admin@fortepanel.local
LOCAL_ADMIN_PASSWORD=CHANGE_ME_LOCAL_ADMIN_PASSWORD
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=none
EMAIL_FROM=
EMAIL_API_KEY=
PUBLIC_APP_URL=http://localhost:3002
FORTE_LOGIN_RATE_LIMIT_WINDOW_MS=900000
FORTE_LOGIN_RATE_LIMIT_STAGE_1_FAILURES=5
FORTE_LOGIN_RATE_LIMIT_STAGE_1_BLOCK_MS=60000
FORTE_LOGIN_RATE_LIMIT_STAGE_2_FAILURES=10
FORTE_LOGIN_RATE_LIMIT_STAGE_2_BLOCK_MS=180000
FORTE_LOGIN_RATE_LIMIT_STAGE_3_FAILURES=15
FORTE_LOGIN_RATE_LIMIT_STAGE_3_BLOCK_MS=900000
PLATFORM_ADMIN_OPEN_IDS=local_admin
JWT_SECRET=CHANGE_ME_JWT_SECRET
FORTE_API_KEY=CHANGE_ME_FORTE_API_KEY
FORTE_API_WORKSPACE_ID=
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SECRET

PANEL_POSTGRES_DB=forte_panel
PANEL_POSTGRES_USER=forte_panel
PANEL_POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
PANEL_POSTGRES_PORT=5432
COMPOSE_PROJECT_NAME=forte-local

BAILEYS_API_KEY=CHANGE_ME_BAILEYS_API_KEY
BAILEYS_WEBHOOK_SECRET=CHANGE_ME_BAILEYS_WEBHOOK_SECRET
BAILEYS_INSTANCE_ID=default
BAILEYS_REQUEST_TIMEOUT_MS=8000
BAILEYS_PORT_PUBLIC=3010
WHATSAPP_WEBHOOK_MAX_ATTEMPTS=8
WHATSAPP_WEBHOOK_INITIAL_BACKOFF_MS=1000
WHATSAPP_WEBHOOK_MAX_BACKOFF_MS=60000
EVENT_WORKER_BATCH_SIZE=10
EVENT_WORKER_MAX_ATTEMPTS=5
WORKER_INTERVAL_MS=1500
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=3

# Deixe vazio no primeiro teste local; a integração Meta permanece desligada.
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Não são necessários para login local, mas ficam documentados para OAuth futuro.
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=
