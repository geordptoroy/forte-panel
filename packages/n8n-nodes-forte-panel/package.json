{
  "name": "n8n-nodes-forte-panel",
  "version": "0.1.0",
  "description": "Community node that exposes the Forte Panel CRM, WhatsApp and scheduling API as one n8n AI Tool.",
  "license": "MIT",
  "keywords": ["n8n-community-node-package", "n8n", "forte-panel", "crm", "whatsapp", "ai-tool"],
  "repository": {
    "type": "git",
    "url": "https://github.com/geordptoroy/forte-panel.git",
    "directory": "packages/n8n-nodes-forte-panel"
  },
  "author": {
    "name": "Forte Panel"
  },
  "files": ["dist", "README.md", "icons"],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/nodes/FortePanel && cp nodes/FortePanel/forte-panel.svg dist/nodes/FortePanel/forte-panel.svg",
    "lint": "eslint nodes credentials --ext .ts",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": ["dist/credentials/FortePanelApi.credentials.js"],
    "nodes": ["dist/nodes/FortePanel/FortePanel.node.js"]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "n8n-workflow": "^1.100.0",
    "typescript": "^5.9.3"
  }
}
