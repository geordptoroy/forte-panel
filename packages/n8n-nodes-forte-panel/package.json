{
  "name": "n8n-nodes-forte-panel",
  "version": "0.5.5",
  "description": "Community node that exposes the Forte Panel CRM, WhatsApp and scheduling API as one n8n AI Tool.",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "forte-panel",
    "crm",
    "whatsapp",
    "ai-tool"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/geordptoroy/forte-panel.git",
    "directory": "packages/n8n-nodes-forte-panel"
  },
  "author": {
    "name": "Forte Panel"
  },
  "files": [
    "dist",
    "README.md",
    "icons"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && mkdir -p dist/nodes/FortePanel && cp nodes/FortePanel/forte-panel.svg dist/nodes/FortePanel/forte-panel.svg",
    "lint": "eslint nodes credentials --ext .ts",
    "dev": "tsc -p tsconfig.json --watch"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/FortePanelApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FortePanel/FortePanel.node.js",
      "dist/nodes/FortePanel/FortePanelAiTool.node.js",
      "dist/nodes/FortePanel/FortePanelBuscarLead.node.js",
      "dist/nodes/FortePanel/FortePanelCriarLead.node.js",
      "dist/nodes/FortePanel/FortePanelAtualizarLead.node.js",
      "dist/nodes/FortePanel/FortePanelRegistrarNota.node.js",
      "dist/nodes/FortePanel/FortePanelAvailability.node.js",
      "dist/nodes/FortePanel/FortePanelCreateAppointment.node.js",
      "dist/nodes/FortePanel/FortePanelCancelAppointment.node.js",
      "dist/nodes/FortePanel/FortePanelRescheduleAppointment.node.js",
      "dist/nodes/FortePanel/FortePanelPublishedPrompt.node.js",
      "dist/nodes/FortePanel/FortePanelQueueMessage.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "n8n-workflow": "^1.100.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@langchain/core": "^0.3.80"
  }
}
