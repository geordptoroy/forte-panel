# Copie para .env na mesma pasta do docker-compose.yaml
# Preencha os valores TROQUE antes de iniciar em produção.

COMPOSE_PROJECT_NAME=evomain
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# PAPI e seus bancos
PAPI_POSTGRES_USER=postgres
PAPI_POSTGRES_PASSWORD=TROQUE_PAPI_POSTGRES_PASSWORD
PAPI_POSTGRES_DB=pastorini
PAPI_POSTGRES_SSL=false
PAPI_REDIS_PASSWORD=
PAPI_REDIS_DB=0
PAPI_LICENSE_KEY=TROQUE_PAPI_LICENSE_KEY
PAPI_API_KEY=<configure-in-your-env>
PAPI_INSTANCE_ID=
PAPI_BASE_URL=http://pastorini_api:3000
PAPI_SEND_MESSAGE_PATH=/messages
PAPI_WEBHOOK_SECRET=TROQUE_PAPI_WEBHOOK_SECRET

# Banco do Forte Panel
PANEL_POSTGRES_USER=forte_panel
PANEL_POSTGRES_PASSWORD=<configure-in-your-env>
PANEL_POSTGRES_DB=forte_panel
PANEL_PORT=3002

# Forte Panel
DEMO_MODE=false
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_EMAIL=admin@fortepanel.local
LOCAL_ADMIN_PASSWORD=TROQUE_ADMIN_PASSWORD
JWT_SECRET=<configure-in-your-env>
FORTE_API_KEY=TROQUE_FORTE_API_KEY
WEBHOOK_SIGNING_SECRET=TROQUE_WEBHOOK_SIGNING_SECRET

# Agente nativo
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=TROQUE_CHAVE_DO_MODELO
AGENT_MODEL=gpt-5-mini
AGENT_DEBOUNCE_MS=1500

# Worker
WORKER_INTERVAL_MS=1500
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=3
EVENT_WORKER_BATCH_SIZE=10
EVENT_WORKER_MAX_ATTEMPTS=5

# Meta fica desligada nesta fase
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Segurança da Fase 1 — gere valores aleatórios fortes e mantenha este arquivo fora do Git
FORTE_PANEL_IMAGE=ghcr.io/geordptoroy/forte-panel:sha-<commit>
REDIS_PANEL_PASSWORD=<senha-aleatoria-redis-panel>
PAPI_REDIS_PASSWORD=<senha-aleatoria-redis-papi>
# JWT_SECRET, PAPI_WEBHOOK_SECRET, WEBHOOK_SIGNING_SECRET e senhas PostgreSQL continuam obrigatórios.

# Provider PAPI: desenvolvimento permanece self-hosted; Cloud será ativada explicitamente depois
PAPI_DEPLOYMENT=self_hosted
PAPI_CLOUD_API_URL=https://api.papi.api.br
PAPI_CLOUD_MANAGEMENT_URL=https://papi.api.br
# PAPI_CLOUD_PANEL_TOKEN=<somente-backend-quando-a-migracao-cloud-for-aprovada>
