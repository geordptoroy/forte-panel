# Copie para .env na mesma pasta do docker-compose.current-dev.yml
# Preencha todos os valores marcados como TROQUE antes de iniciar em produção.

COMPOSE_PROJECT_NAME=forte-stack
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# Banco da PAPI
PAPI_POSTGRES_USER=postgres
PAPI_POSTGRES_PASSWORD=TROQUE_PAPI_POSTGRES_PASSWORD
PAPI_POSTGRES_DB=pastorini
PAPI_POSTGRES_SSL=false
PAPI_REDIS_PASSWORD=
PAPI_REDIS_DB=0
PAPI_LICENSE_KEY=TROQUE_PAPI_LICENSE_KEY
PAPI_API_KEY=TROQUE_PAPI_API_KEY
PAPI_INSTANCE_ID=

# Banco do n8n
N8N_POSTGRES_USER=n8n
N8N_POSTGRES_PASSWORD=TROQUE_N8N_POSTGRES_PASSWORD
N8N_POSTGRES_DB=n8n
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=TROQUE_N8N_PASSWORD
N8N_ENCRYPTION_KEY=TROQUE_N8N_ENCRYPTION_KEY_COM_32_CARACTERES
N8N_HOST=n8n
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://n8n:5678
N8N_AUDIO_HOST_PATH=./audios

# Banco do Forte Panel
PANEL_POSTGRES_USER=forte_panel
PANEL_POSTGRES_PASSWORD=TROQUE_PANEL_POSTGRES_PASSWORD
PANEL_POSTGRES_DB=forte_panel
PANEL_PORT=3002

# Forte Panel
DEMO_MODE=false
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_EMAIL=admin@fortepanel.local
LOCAL_ADMIN_PASSWORD=TROQUE_ADMIN_PASSWORD
JWT_SECRET=TROQUE_JWT_SECRET_COM_32_CARACTERES
FORTE_API_KEY=TROQUE_FORTE_API_KEY
WEBHOOK_SIGNING_SECRET=TROQUE_WEBHOOK_SIGNING_SECRET
PAPI_WEBHOOK_SECRET=TROQUE_PAPI_WEBHOOK_SECRET
PAPI_BASE_URL=http://pastorini_api:3000
PAPI_SEND_MESSAGE_PATH=/messages

# Integração temporária Panel -> n8n
N8N_BASE_URL=http://n8n:5678
N8N_EVENTS_WEBHOOK_URL=http://n8n:5678/webhook/forte-panel-event
N8N_WEBHOOK_SECRET=TROQUE_N8N_WEBHOOK_SECRET
N8N_WEBHOOK_TIMEOUT_MS=10000
N8N_DEBOUNCE_MS=1500

# Workers
WORKER_INTERVAL_MS=1500
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=3
EVENT_WORKER_BATCH_SIZE=10
EVENT_WORKER_MAX_ATTEMPTS=5

# Meta fica desligada nesta fase
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
