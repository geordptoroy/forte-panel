NODE_ENV=production
PORT=3000
# false = instalação real; true = apenas demonstração visual com dados de exemplo
DEMO_MODE=false
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_EMAIL=admin@fortepanel.local
LOCAL_ADMIN_PASSWORD=troque-por-uma-senha-forte
JWT_SECRET=<configure-in-your-env>
WORKSPACE_NAME=Minha empresa
WORKSPACE_SLUG=minha-empresa
WORKSPACE_SEGMENT=servicos
WORKSPACE_TIMEZONE=America/Sao_Paulo
PANEL_PORT=3002
PANEL_POSTGRES_DB=forte_panel
PANEL_POSTGRES_USER=forte_panel
PANEL_POSTGRES_PASSWORD=<configure-in-your-env>
FORTE_API_KEY=troque-esta-chave
WEBHOOK_SIGNING_SECRET=troque-este-segredo

# OAuth do ambiente local; preencher para acessar a interface sem modo demonstração
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=

COMPOSE_PROJECT_NAME=forte-local

PAPI_BASE_URL=http://pastorini_api:3000
PAPI_API_KEY=<configure-in-your-env>
PAPI_SEND_MESSAGE_PATH=/messages
EVENT_WORKER_BATCH_SIZE=10
EVENT_WORKER_MAX_ATTEMPTS=5

# Meta fica desligada no primeiro teste local
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
