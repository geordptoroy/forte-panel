NODE_ENV=production
PORT=3000
DEMO_MODE=true
FORTE_API_KEY=teste-panel-local
WEBHOOK_SIGNING_SECRET=teste-webhook-local

# OAuth do ambiente local/Manus; preencher se o login for usado
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=

# Rede Docker criada pelo compose principal da stack
PASTORINI_NETWORK=forte-local_pastorini-network

# PAPI e n8n são resolvidos pelo nome do serviço na rede Docker
PAPI_API_KEY=teste123
N8N_API_KEY=

# Meta fica desligada no primeiro teste local
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
