NODE_ENV=production
PORT=3000
# false = instalação real; true = apenas demonstração visual com dados de exemplo
DEMO_MODE=false
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_EMAIL=admin@fortepanel.local
LOCAL_ADMIN_PASSWORD=troque-por-uma-senha-forte
# Opcional: adiciona várias contas independentes ao fallback LOCAL_ADMIN.
# Mantenha senhas reais apenas no .env local, nunca no repositório.
PLATFORM_ADMIN_ACCOUNTS_JSON=[{"email":"admin1@example.com","password":"troque-por-uma-senha-1","name":"Admin 1"},{"email":"admin2@example.com","password":"troque-por-uma-senha-2","name":"Admin 2"},{"email":"admin3@example.com","password":"troque-por-uma-senha-3","name":"Admin 3"}]
# Recuperação por e-mail fica desligada até configurar provider, domínio e remetente.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=none
EMAIL_FROM=
EMAIL_API_KEY=
PUBLIC_APP_URL=http://localhost:3000
# Reservado para o adapter SMTP; não commitar valores reais.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Acesso explícito ao console de plataforma; para o admin local, use local_admin.
PLATFORM_ADMIN_OPEN_IDS=local_admin
JWT_SECRET=<configure-in-your-env>
WORKSPACE_NAME=Minha empresa
WORKSPACE_SLUG=minha-empresa
WORKSPACE_SEGMENT=servicos
WORKSPACE_TIMEZONE=America/Sao_Paulo
PANEL_PORT=3002
PANEL_POSTGRES_DB=forte_panel
PANEL_POSTGRES_USER=forte_panel
PANEL_POSTGRES_PASSWORD=<configure-in-your-env>
FORTE_API_KEY=troque-esta-chave
# Workspace fixado à chave da API REST legada; informe o ID numérico somente após verificar no banco.
FORTE_API_WORKSPACE_ID=
WEBHOOK_SIGNING_SECRET=troque-este-segredo

# OAuth do ambiente local; preencher para acessar a interface sem modo demonstração
VITE_APP_ID=
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=

COMPOSE_PROJECT_NAME=forte-local

BAILEYS_BASE_URL=http://forte-whatsapp:3010
BAILEYS_API_KEY=troque-esta-chave-interna-local
BAILEYS_WEBHOOK_SECRET=troque-este-segredo-local
BAILEYS_INSTANCE_ID=default
BAILEYS_REQUEST_TIMEOUT_MS=8000
BAILEYS_PORT_PUBLIC=3010
BAILEYS_BASE_URL=http://forte-whatsapp:3010
BAILEYS_API_KEY=troque-esta-chave-interna-local
BAILEYS_WEBHOOK_SECRET=troque-este-segredo-local
BAILEYS_INSTANCE_ID=default
EVENT_WORKER_BATCH_SIZE=10
EVENT_WORKER_MAX_ATTEMPTS=5

# Meta fica desligada no primeiro teste local
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
