# Use este arquivo apenas como referência.
# Na sua stack, preserve o .env existente para manter as credenciais atuais da PAPI e do Panel.
COMPOSE_PROJECT_NAME=evomain
NODE_ENV=production
TZ=America/Sao_Paulo
GENERIC_TIMEZONE=America/Sao_Paulo

# PAPI existente
PAPI_POSTGRES_USER=postgres
PAPI_POSTGRES_PASSWORD=COLE_A_SENHA_EXISTENTE_DA_PAPI
PAPI_POSTGRES_DB=pastorini
PAPI_LICENSE_KEY=COLE_A_LICENSE_EXISTENTE_DA_PAPI
PAPI_API_KEY=<configure-in-your-env>
PAPI_INSTANCE_ID=
PAPI_BASE_URL=http://pastorini_api:3000
PAPI_SEND_MESSAGE_PATH=/messages
PAPI_WEBHOOK_SECRET=COLE_O_SEGREDO_DO_WEBHOOK

# Gateway WhatsApp próprio (em implementação; preserve a PAPI durante a transição)
BAILEYS_BASE_URL=http://forte-whatsapp:3010
BAILEYS_API_KEY=COLE_UMA_CHAVE_INTERNA_LOCAL
BAILEYS_WEBHOOK_SECRET=COLE_UM_SEGREDO_INTERNO_LOCAL
BAILEYS_INSTANCE_ID=default
# URL interna funciona quando PAPI e Panel estão na mesma rede Docker.
PAPI_WEBHOOK_URL=http://forte-panel:3000/api/v1/webhooks/providers/papi
# Se a PAPI estiver fora desta rede, use uma URL HTTPS acessível por ela.
PANEL_PUBLIC_URL=
PAPI_PORT_PUBLIC=3000

# Forte Panel existente
PANEL_POSTGRES_USER=forte_panel
PANEL_POSTGRES_PASSWORD=<configure-in-your-env>
PANEL_POSTGRES_DB=forte_panel
PANEL_PORT=3002
DEMO_MODE=false
LOCAL_AUTH_ENABLED=true
LOCAL_ADMIN_EMAIL=COLE_O_EMAIL_ADMIN_EXISTENTE
LOCAL_ADMIN_PASSWORD=COLE_A_SENHA_ADMIN_EXISTENTE
# Acesso separado do workspace; no admin local padrão, use local_admin.
PLATFORM_ADMIN_OPEN_IDS=local_admin
JWT_SECRET=<configure-in-your-env>
FORTE_API_KEY=COLE_A_CHAVE_DO_PANEL
WEBHOOK_SIGNING_SECRET=COLE_O_SEGREDO_DE_ASSINATURA
RUN_MIGRATIONS=true

# Os modelos são cadastrados na interface, não aqui.
# Sistema -> Configuração da empresa -> Agente nativo
AGENT_DEBOUNCE_MS=1500

# Worker
WORKER_INTERVAL_MS=1500
WORKER_BATCH_SIZE=10
WORKER_MAX_ATTEMPTS=3
EVENT_WORKER_BATCH_SIZE=10
EVENT_WORKER_MAX_ATTEMPTS=5

# Meta opcional
META_GRAPH_API_VERSION=v23.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Segurança da Fase 1
FORTE_PANEL_IMAGE=ghcr.io/geordptoroy/forte-panel:sha-<commit>
REDIS_PANEL_PASSWORD=<senha-aleatoria-redis-panel>
PAPI_REDIS_PASSWORD=<senha-aleatoria-redis-papi>

# Provider PAPI: desenvolvimento permanece self-hosted; Cloud será ativada explicitamente depois
PAPI_DEPLOYMENT=self_hosted
PAPI_CLOUD_API_URL=https://api.papi.api.br
PAPI_CLOUD_MANAGEMENT_URL=https://papi.api.br
# PAPI_CLOUD_PANEL_TOKEN=<somente-backend-quando-a-migracao-cloud-for-aprovada>
PAPI_CLOUD_PROVISIONING_ENABLED=false
